{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // index.ts funkcji Supabase działa w Deno (inne typy i importy); logic.ts sprawdzamy
  "exclude": ["node_modules", "supabase/functions/*/index.ts"]
}
